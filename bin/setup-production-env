#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ $# -ne 1 || ! "$1" =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?$ ]]; then
  echo "Usage: bin/setup-production-env https://support.example.com" >&2
  exit 1
fi

if [[ -e .env ]]; then
  echo ".env already exists. Edit it directly; existing keys must be preserved." >&2
  exit 1
fi

umask 077
set -o noclobber
secret_key_base=$(openssl rand -hex 64)
encryption_primary_key=$(openssl rand -hex 32)
encryption_deterministic_key=$(openssl rand -hex 32)
encryption_key_derivation_salt=$(openssl rand -hex 32)
postgres_password=$(openssl rand -hex 32)
redis_password=$(openssl rand -hex 32)

sed \
  -e "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$secret_key_base|" \
  -e "s|^# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=.*|ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$encryption_primary_key|" \
  -e "s|^# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=.*|ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$encryption_deterministic_key|" \
  -e "s|^# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=.*|ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$encryption_key_derivation_salt|" \
  -e "s|^FRONTEND_URL=.*|FRONTEND_URL=$1|" \
  -e 's|^FORCE_SSL=.*|FORCE_SSL=true|' \
  -e 's|^RAILS_ENV=.*|RAILS_ENV=production|' \
  -e 's|^# POSTGRES_DATABASE=.*|POSTGRES_DATABASE=chatwoot_production|' \
  -e "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$postgres_password|" \
  -e "s|^REDIS_PASSWORD=.*|REDIS_PASSWORD=$redis_password|" \
  .env.example > .env

echo "Created .env with new database, Redis, session and encryption keys."
echo "Configure SMTP in .env, then run: docker compose -f docker-compose.production.yaml up -d --build"
